{
  "name": "najib",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "dev:admin": "pnpm --filter @najib/admin dev",
    "build:admin": "pnpm --filter @najib/admin build",
    "typecheck:admin": "pnpm --filter @najib/admin typecheck",
    "lint:admin": "pnpm --filter @najib/admin lint",
    "dev:commerce": "pnpm --filter @najib/contracts build && pnpm --filter @najib/commerce-service run dev",
    "dev:inventory": "pnpm --filter @najib/contracts build && pnpm --filter @najib/inventory-service run dev",
    "dev:payment": "pnpm --filter @najib/contracts build && pnpm --filter @najib/payment-service run dev",
    "dev:customer-data": "pnpm --filter @najib/contracts build && pnpm --filter @najib/customer-data-service run dev",
    "infra:up": "docker compose -f infrastructure/compose.yaml up -d",
    "infra:down": "docker compose -f infrastructure/compose.yaml down",
    "infra:logs": "docker compose -f infrastructure/compose.yaml logs -f",
    "infra:status": "docker compose -f infrastructure/compose.yaml ps",
    "test:apis": "node scripts/test-apis.js",
    "test:inventory-flow": "pnpm --filter @najib/inventory-service build && node scripts/test-inventory-flow.js",
    "test:vertical-slice": "pnpm contracts:build && pnpm build:services && node scripts/test-vertical-slice.js",
    "contracts:build": "pnpm --filter @najib/contracts build",
    "contracts:typecheck": "pnpm --filter @najib/contracts typecheck",
    "contracts:test": "pnpm --filter @najib/contracts test",
    "build": "next build",
    "build:services": "pnpm --filter './services/*' run build",
    "start": "next start",
    "lint": "eslint",
    "models:build": "pnpm --filter './services/*' run build",
    "models:typecheck": "pnpm --filter './services/*' run typecheck",
    "models:test": "pnpm --filter './services/*' run test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "mongoose": "^8.24.4",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "turbo": "^2.5.6",
    "typescript": "^5"
  }
}
